{
  "cleanUrls": true,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web-desktop-chi.vercel.app"
        }
      ],
      "destination": "https://monitor-mr.vercel.app/$1",
      "permanent": true
    }
  ]
}
